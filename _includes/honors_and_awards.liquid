<div class="honors">
  {% assign all_items = site.honors_and_awards | sort: "date" | reverse %}

  {% if include.only_selected %}
    {% assign items = all_items | where_exp: "i", "i.selected == true" %}
  {% else %}
    {% assign items = all_items %}
  {% endif %}

  {% if items != blank %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in items %}
          <tr>
            <td>
              {% if item.external_url %}
                <a class="news-title" href="{{ item.external_url | relative_url }}">{{ item.title }}</a>
              {% else %}
                <span class="news-title">{{ item.title }}</span>
              {% endif %}

              {% if item.date or item.awarder %}
                <div class="text-muted" style="font-size: 0.95rem;">
                  {% if item.date %}{{ item.date | date: '%b %d, %Y' }}{% endif %}
                  {% if item.awarder %} — {{ item.awarder }}{% endif %}
                </div>
              {% endif %}

              {% if item.summary %}
                <div style="font-size: 0.95rem; font-style: italic;">
                  {{ item.summary }}
                </div>
              {% endif %}

              <div class="links">
                {% if item.video and site.enable_video_embedding %}
                  <a class="abstract btn btn-sm z-depth-0" role="button">Video</a>
                {% elsif item.video %}
                  <a href="{{ item.video }}" class="btn btn-sm z-depth-0" role="button" target="_blank">Video</a>
                {% endif %}
                {% if item.certificate %}
                  <a href="{{ item.certificate }}" class="btn btn-sm z-depth-0" role="button" {% if item.certificate contains '://' %}target="_blank"{% endif %}>Certificate</a>
                {% endif %}
                {% if item.photos %}
                  <a href="{{ item.photos }}" class="btn btn-sm z-depth-0" role="button" {% if item.photos contains '://' %}target="_blank"{% endif %}>Photos</a>
                {% endif %}
              </div>
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No honors or awards so far...</p>
  {% endif %}
</div>