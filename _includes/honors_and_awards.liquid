<div class="honors">
  {% assign all_items = site.honors_and_awards | sort: 'date' | reverse %}

  {% if include.only_selected %}
    {% assign items = all_items | where_exp: 'i', 'i.selected == true' %}
  {% else %}
    {% assign items = all_items %}
  {% endif %}

  {% if items != blank %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in items %}
          <tr>
            <td>
              {% if item.external_url %}
                <a class="news-title" href="{{ item.external_url | relative_url }}"
                  ><strong>{{ item.title }}</strong></a
                >
              {% else %}
                <span class="news-title"
                  ><strong>{{ item.title }}</strong></span
                >
              {% endif %}

              {% if item.date or item.awarder %}
                <div class="text-muted" style="font-size: 0.95rem;">
                  {% if item.date %}{{ item.date | date: '%b %d, %Y' }}{% endif %}
                  {% if item.awarder %} — {{ item.awarder }}{% endif %}
                </div>
              {% endif %}

              {% if item.summary %}
                <div style="font-size: 0.95rem; font-style: italic;">
                  {{ item.summary }}
                </div>
              {% endif %}

              {% if item.video or item.news %}
                <div class="links mt-1">
                  {% if item.video %}
                    <a href="{{ item.video | relative_url }}" class="btn btn-sm z-depth-0" role="button">Video</a>
                  {% endif %}
                  {% if item.news %}
                    <a href="{{ item.news | relative_url }}" class="btn btn-sm z-depth-0" role="button">Article</a>
                  {% endif %}
                </div>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No honors or awards so far...</p>
  {% endif %}
</div>
